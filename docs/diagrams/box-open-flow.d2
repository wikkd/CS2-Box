title: { label: "CS2-Box 玩家开箱全流程（三条支线 + 共享落地）" }

玩家: {
  shape: person
  label: "玩家"
}

click: {
  shape: rectangle
  label: "ClickEvent.onRightClick\n右键拦截（仅主手 · 仅客户端 LocalPlayer）"
}

分流: {
  shape: diamond
  label: "手持 instanceof\nItemCsgoBox?"
}

忽略: {
  shape: step
  label: "忽略（不拦截）"
}

# ================= 支线一：单开 =================
csbox: {
  shape: rectangle
  label: "CsboxScreen 经典预览屏\n构造时发 PacketRequestBoxItems"
}
预览服务端: {
  shape: rectangle
  label: "PacketRequestBoxItems.handle\n按 box_id 回填预览"
}
单开请求: {
  shape: step
  label: "点【开启】→ 本地查钥匙（仅提示）\n发 PacketCsgoProgress"
}
单开服务端: {
  shape: rectangle
  label: "PacketCsgoProgress.handleServer\n校验链 → 消耗钥匙 → SecureRandom 种子\n→ BoxStripGenerator 生成条带"
}
单开结果: {
  shape: rectangle
  label: "PacketBoxOpenResult\n（动画条带 + 获胜索引 + 等级）"
}
progress: {
  shape: rectangle
  label: "CsboxProgressScreen\n播放滚动动画（服务端数据驱动）"
}
look: {
  shape: rectangle
  label: "CsLookItemScreen\n单件奖品弹窗"
}

# ================= 支线二：批量 =================
批量总览: {
  shape: rectangle
  label: "CsboxBulkOverviewScreen\nShift 右键进入，客户端数箱子+钥匙"
}
批量确认: {
  shape: rectangle
  label: "CsboxConfirmScreen\n二次确认（提示将消耗 N 箱+N 钥匙）"
}
批量请求: {
  shape: step
  label: "确认 → 发 PacketCsgoBulkProgress"
}
批量服务端: {
  shape: rectangle
  label: "PacketCsgoBulkProgress.handleServer\n服务端重数 K = min(箱子,钥匙)\n异步线程池抽 K 次 → 主线程原子消费"
}
批量结果: {
  shape: rectangle
  label: "PacketBoxOpenResult（第1箱动画）\n+ PacketBoxBulkResult（其余分块）"
}
bulk_result_screen: {
  shape: rectangle
  label: "CsboxBulkResultScreen\n瀑布流展示 K-1 件 → 收集"
}

# ================= 支线三：终端 =================
boot: {
  shape: rectangle
  label: "TerminalBootScreen\n终端启动屏（布局同预览屏）"
}
open: {
  shape: rectangle
  label: "PacketTerminalOpen（C→S）\n服务端主手为权威 → 取会话锁\n新会话打 terminal_uid / 续谈恢复"
}
state: {
  shape: rectangle
  label: "PacketTerminalState（S→C）\n全量快照：轮次/状态/历史/\n倒计时/5 轮报价+物品/槽位物品"
}
locked: {
  shape: rectangle
  label: "锁死态 FAILED\n被他人活跃会话持有\n军火商「去问问xx吧」"
}
terminal: {
  shape: rectangle
  label: "TerminalScreen\n谈判报价 → 报价卡片 → 二次确认"
}
reject: {
  shape: step
  label: "拒绝 → PacketTerminalReject\n服务端强制推进"
}
fail5: {
  shape: rectangle
  label: "第 5 轮拒绝 → FAILED\n锁释放，重开全新谈判"
}
购买请求: {
  shape: step
  label: "接受报价 → 发 PacketTerminalBuy"
}
购买服务端: {
  shape: rectangle
  label: "PacketTerminalBuy\n按服务端当轮实际物品校验\n扣军械库点数（创造不扣）\n磨损 → 授予 → 销毁终端机+uid"
}
购买结果: {
  shape: rectangle
  label: "PacketTerminalBuyResult\n→ TerminalScreen 展示购买结果"
}
close: {
  shape: step
  label: "关屏 → PacketTerminalClose\n服务端钉住轮次/状态"
}
计时: {
  shape: step
  label: "服务端 1Hz tick\n世界时钟推进倒计时"
}
超时销毁: {
  shape: rectangle
  label: "3h 期满 → 超时自毁\n在线：背包按 uid 销毁物品\n离线/容器：uid 入已销毁集合\n下次打开当场销毁（FAILED）"
}

# ================= 共享落地 =================
落地: {
  shape: rectangle
  label: "授予落地（三条支线共用）\n背包 add → 满则 drop 掉落"
}
副作用: {
  shape: rectangle
  label: "副作用（仅单开/批量触发）\nopened_boxes 统计 · OpenedBoxTrigger 成就\nBoxOpenedEvent（KubeJS 可监听）"
}

玩家 -> click: "右键手持箱子"
click -> 分流: "是"
click -> 忽略: "否（副手/服务端）"

分流 -> csbox: "普通箱子 · 未按 Shift"
分流 -> 批量总览: "普通箱子 · Shift"
分流 -> boot: "ItemTerminal（终端机）"

csbox -> 预览服务端: "PacketRequestBoxItems（C→S）"
预览服务端 -> csbox: "PacketSyncBoxItems（S→C）\n回填物品/钥匙"
csbox -> 单开请求: "预览就绪"
单开请求 -> 单开服务端: "PacketCsgoProgress（C→S）"
单开服务端 -> 单开结果: "PacketBoxOpenResult（S→C）"
单开结果 -> progress
progress -> look: "单开 · 动画结束"
progress -> bulk_result_screen: "批量 · chunk 收齐"

批量总览 -> 批量确认: "点【确认】"
批量确认 -> 批量请求: "确认开启"
批量请求 -> 批量服务端: "PacketCsgoBulkProgress（C→S）"
批量服务端 -> 批量结果: "PacketBoxOpenResult + PacketBoxBulkResult（S→C）"
批量结果 -> progress: "聚合 chunk"

boot -> open: "点【开启】"
open -> state: "取锁成功 → 下发全量快照"
state -> terminal: "渲染谈判屏"
open -> locked: "被他人活跃会话持有"
terminal -> reject: "拒绝报价"
reject -> state: "下一轮快照（未满 5 轮）"
reject -> fail5: "第 5 轮拒绝"
terminal -> 购买请求: "接受报价"
购买请求 -> 购买服务端: "PacketTerminalBuy（C→S）"
购买服务端 -> 购买结果: "PacketTerminalBuyResult（S→C）"
terminal -> close: "关屏"
close -> open: "重开 → 恢复快照（续谈）"
terminal -> 计时: "打开即计时（世界时钟 3h）"
计时 -> 超时销毁: "期满未成交"

单开服务端 -> 落地
批量服务端 -> 落地
购买服务端 -> 落地
落地 -> 副作用: "仅单开/批量触发\n（购买不走开箱事件）"
