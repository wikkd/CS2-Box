title: { label: "CS2-Box 开箱判定链与边界情况（服务端权威）" }

# ================= 客户端入口判定 =================
入口判定: {
  gap: 36
  label: "客户端入口判定"
  主手: {
    shape: diamond
    label: "事件在主手?"
  }
  本地: {
    shape: diamond
    label: "客户端玩家?"
  }
  箱子类: {
    shape: diamond
    label: "手持是箱子物品?"
}
  忽略: {
    shape: step
    label: "忽略（不拦截）"
  }
  分流: {
    shape: step
    label: "openScreen() →\n普通 / 批量 / 终端"
  }
  主手 -> 本地: "是"
  主手 -> 忽略: "否"
  本地 -> 箱子类: "是"
  本地 -> 忽略: "否"
  箱子类 -> 分流: "是"
  箱子类 -> 忽略: "否"
}

# ================= 服务端前序校验 =================
前序校验: {
  gap: 36
  label: "服务端前序校验（PacketCsgoProgress）"
  箱子类2: {
    shape: diamond
    label: "手持是箱子物品?"
}
  存活: {
    shape: diamond
    label: "存活且未移除?"
  }
  冷却: {
    shape: diamond
    label: "冷却中?"
  }
  boxid: {
    shape: diamond
    label: "箱子定义存在?"
  }
  权重: {
    shape: diamond
    label: "有权重?"
  }
  钥匙: {
    shape: diamond
    label: "钥匙足够?"
  }
  拒绝: {
    shape: step
    label: "sendRejected\n（空动画结果）"
  }
  抽奖: {
    shape: step
    label: "SecureRandom 种子 →\nBoxStripGenerator 生成条带"
  }
  箱子类2 -> 存活: "是"
  箱子类2 -> 拒绝: "否"
  存活 -> 冷却: "是"
  存活 -> 拒绝: "否（死亡/移除）"
  冷却 -> boxid: "未冷却"
  冷却 -> 拒绝: "冷却中（10 tick）"
  boxid -> 权重: "有"
  boxid -> 拒绝: "无"
  权重 -> 钥匙: "非空"
  权重 -> 拒绝: "空"
  钥匙 -> 抽奖: "已消耗"
  钥匙 -> 拒绝: "不足（不消耗）"
  抽奖 -> 回包: "生成条带 → PacketBoxOpenResult"
}

回包: {
  shape: rectangle
  label: "回传动画条带（客户端播放）"
  回包 -> 空结果: "空结果"
  回包 -> 正常动画: "正常"
}

空结果: {
  shape: rectangle
  label: "客户端提示后关闭\n（冷却/死亡/缺钥匙）"
}
正常动画: {
  shape: rectangle
  label: "CsboxProgressScreen\n播放滚动动画"
}

# ================= 钥匙判定 =================
钥匙判定: {
  gap: 36
  label: "钥匙判定分支"
  无钥匙: {
    shape: diamond
    label: "无需钥匙?"
  }
  创造: {
    shape: diamond
    label: "创造模式?"
  }
  消费: {
    shape: step
    label: "全槽位扫描消费\n（物品栏+护甲+副手）\n跳过箱子实例防误吞"
  }
  通过: {
    shape: step
    label: "通过（无需钥匙）"
  }
  无钥匙 -> 通过: "是（终端机/无钥匙箱）"
  无钥匙 -> 创造: "否"
  创造 -> 通过: "是（不消耗）"
  创造 -> 消费: "否"
  消费 -> 通过: "扣到即通过"
}

# ================= 批量判定 =================
批量判定: {
  gap: 36
  label: "批量判定（PacketCsgoBulkProgress）"
  计数: {
    shape: step
    label: "countAvailability\n服务端重数箱子+钥匙"
  }
  上限: {
    shape: diamond
    label: "K 合法?"
  }
  异步: {
    shape: step
    label: "异步线程池 computeKResults\n抽 K 次（不碰 MC API）"
  }
  复核: {
    shape: step
    label: "主线程 finalizeBulkOpen\n复核 actualK 后原子消费"
  }
  退箱: {
    shape: step
    label: "钥匙不足 → 退还箱子\nrefundBoxes"
  }
  发结果: {
    shape: step
    label: "第1箱 PacketBoxOpenResult\n其余 PacketBoxBulkResult 分块"
  }
  无结果: {
    shape: step
    label: "静默返回（K=0 不开启）"
  }
  计数 -> 上限: "K = min(boxes, keys)"
  上限 -> 异步: "K > 0（min(箱子,钥匙) ≤ 上限）"
  上限 -> 无结果: "K = 0"
  异步 -> 复核
  复核 -> 退箱: "钥匙不足"
  复核 -> 发结果: "消费成功"
  退箱 -> 发结果
}

# ================= 终端谈判判定 =================
终端判定: {
  gap: 36
  label: "终端谈判判定（服务端权威：PacketTerminalOpen/Buy/Reject + 1Hz tick）"
  开主手: {
    shape: diamond
    label: "主手是终端机?"
  }
  开拒绝: {
    shape: step
    label: "unreachable FAILED\n（无法联系军火商）"
  }
  开销毁: {
    shape: diamond
    label: "命中已销毁 uid?"
  }
  开销毁处理: {
    shape: step
    label: "当场销毁物品 + 消耗 uid\n+ FAILED 快照"
  }
  开锁: {
    shape: diamond
    label: "被他人活跃会话持有?"
  }
  锁死: {
    shape: step
    label: "锁死态 FAILED\n军火商「去问问xx吧」"
  }
  开会话: {
    shape: diamond
    label: "已有本玩家会话?"
  }
  新会话: {
    shape: step
    label: "打 terminal_uid + 盖 terminal_owner\n采样 5 轮报价"
  }
  续谈: {
    shape: step
    label: "恢复全量快照\n（轮次/历史/倒计时/报价/物品）"
  }
  谈判: {
    shape: step
    label: "TerminalScreen 谈判"
  }
  拒绝: {
    shape: diamond
    label: "第 5 轮拒绝?"
  }
  推进: {
    shape: step
    label: "rejectForced 下一轮\n（服务端强制推进）"
  }
  失败: {
    shape: step
    label: "FAILED → 释放锁\n重开全新谈判"
  }
  购买: {
    shape: diamond
    label: "当轮实际物品校验\n+ 点数足够?"
  }
  购买失败: {
    shape: step
    label: "拒绝（不扣点数）"
  }
  成交: {
    shape: step
    label: "磨损 → 授予物品\n销毁终端机 + uid → 释放锁"
  }
  超时: {
    shape: step
    label: "1Hz tick（世界时钟）\n3h 期满 → FAILED\n背包按 uid 销毁；离线/容器\nuid 入已销毁集合"
  }
  开主手 -> 开销毁: "是"
  开主手 -> 开拒绝: "否"
  开销毁 -> 开销毁处理: "是"
  开销毁 -> 开锁: "否"
  开锁 -> 锁死: "是"
  开锁 -> 开会话: "否"
  开会话 -> 续谈: "是"
  开会话 -> 新会话: "否"
  新会话 -> 谈判: "下发全量快照"
  续谈 -> 谈判: "下发全量快照"
  谈判 -> 拒绝: "拒绝报价"
  拒绝 -> 推进: "否"
  拒绝 -> 失败: "是"
  推进 -> 谈判: "下一轮快照"
  谈判 -> 购买: "接受报价"
  购买 -> 购买失败: "校验不过"
  购买 -> 成交: "校验通过"
  谈判 -> 超时: "打开即计时"
}

# ================= 授予落地 =================
授予落地: {
  gap: 36
  label: "授予落地（三条支线共用）"
  保底: {
    shape: step
    label: "获胜物品为空 →\nfindFallback(1) 保底"
  }
  磨损: {
    shape: step
    label: "damageItemByWear\n按 wear 损伤耐久（永不断裂）"
  }
  背包: {
    shape: diamond
    label: "背包 add 成功?"
  }
  掉落: {
    shape: step
    label: "drop 掉落到地面"
  }
  副作用: {
    shape: step
    label: "opened_boxes 统计\nOpenedBoxTrigger 成就\nBoxOpenedEvent（KubeJS）"
  }
  保底 -> 磨损
  磨损 -> 背包: "先磨损再授予"
  背包 -> 副作用: "进背包"
  背包 -> 掉落: "背包满"
}
