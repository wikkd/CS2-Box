# User-specific stuff
.idea/
!.idea/
.idea/*
!.idea/runConfigurations/
!.idea/runConfigurations/*.xml

*.iml
*.ipr
*.iws

# IntelliJ
out/
# mpeltonen/sbt-idea plugin
.idea_modules/

# JIRA plugin
atlassian-ide-plugin.xml

